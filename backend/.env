# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# RABBITMQ_USER/RABBITMQ_PASSWORD sont injectées par le docker-compose racine
# (voir services.backend.environment) ; "rabbitmq" est le nom du service sur
# le réseau "app", pas "localhost".
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Volontairement vide ici (même logique que APP_SECRET) : la passphrase est un
# secret. Valeurs jetables pour dev/test dans .env.dev / .env.test ; en
# préprod/prod elle vient du Secret `backend-secrets` (External Secrets
# Operator, cf. k8s/overlays/*/external-secrets.yaml).
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> app (Portfolio/Cv) ###
# Chemin absolu vers le PDF servi par GET /api/cv (jamais commité, voir
# backend/resources/README.md). En préprod/prod, ce chemin est monté par
# l'orchestrateur, jamais copié dans l'image.
CV_FILE_PATH=%kernel.project_dir%/resources/private/cv/cv.pdf
# Nom de fichier proposé au téléchargement : volontairement générique pour
# qu'aucune donnée personnelle identifiante n'apparaisse dans le code source
# commité (cf. CLAUDE.md objectif n°9). Personnalisable via .env.local.
CV_DOWNLOAD_FILENAME=cv.pdf
###< app ###

###> symfony/mailer ###
# Dev : "null://null" = les emails sont ignorés (aucun envoi). Pour tester le
# rendu en local, lancer Mailpit et mettre "smtp://localhost:1025" dans
# .env.local.
# Préprod / prod : Scaleway Transactional Email, injecté via le Secret
# `backend-secrets` (External Secrets Operator). Format du DSN, transport
# fourni par symfony/scaleway-mailer :
#   scaleway+api://<PROJECT_ID>:<API_KEY_SECRET>@default   (recommandé)
#   scaleway+smtp://<PROJECT_ID>:<API_KEY_SECRET>@default
# Prérequis : le domaine cp-ghostotof.com validé dans la console Scaleway TEM
# (SPF + DKIM), et une clé API scopée TransactionalEmail sur le bon projet.
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/scaleway-mailer ###
###< symfony/scaleway-mailer ###

###> app (Contact) ###
# From des notifications du formulaire de contact : adresse d'envoi dédiée du
# domaine (jamais une vraie boîte). Doit appartenir à un domaine validé dans
# Scaleway TEM.
CONTACT_SENDER_EMAIL=noreply@cp-ghostotof.com
# To des notifications : la boîte de contact publique, redirigée vers la vraie
# boîte via Cloudflare Email Routing. Reply-To = l'email du visiteur.
CONTACT_RECIPIENT_EMAIL=contact@cp-ghostotof.com
###< app ###
