# Extensions enregistrees automatiquement par phpstan/extension-installer :
# phpstan-symfony, phpstan-doctrine, phpstan-phpunit, phpstan-strict-rules,
# phpstan-deprecation-rules. Pas de baseline : niveau max + strict-rules
# passent au vert sur src/ ET tests/ (cf. ignoreErrors scopes plus bas pour
# les payloads JSON des tests fonctionnels). Le garder ainsi.

parameters:
    # Niveau maximal (cf. standards du projet). strict-rules et les extensions
    # ci-dessus s'ajoutent par-dessus.
    level: max

    paths:
        - src
        - tests

    # Fichier squelette gere par Symfony Flex (regenerable) : on ne l'analyse
    # pas. src/Kernel.php l'est depuis #675 (il enregistre une compiler pass) :
    # le faux positif method.unused de getAllowedEnvs() qui l'excluait ne se
    # produit plus (mesure le 2026-10-21).
    excludePaths:
        - tests/bootstrap.php

    # Charge le .env pour que l'analyse voie les memes variables qu'a l'execution.
    bootstrapFiles:
        - tests/bootstrap.php

    # phpstan-symfony : conteneur DI compile de l'env dev, pour resoudre les
    # types des services recuperes via le conteneur, les arguments de commandes,
    # etc. Genere par `php bin/console cache:warmup --env=dev` (fait par le job
    # CI phpstan-backend avant l'analyse).
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    # phpstan-doctrine : comprehension fine des entites, des repositories et du
    # DQL a partir d'un EntityManager reel (cf. tests/object-manager.php).
    doctrine:
        objectManagerLoader: tests/object-manager.php

    ignoreErrors:
        # Dans les tests fonctionnels, le payload de reponse est du `mixed`
        # apres json_decode : ce sont les assertions PHPUnit qui valident la
        # forme de la reponse HTTP, pas l'analyse statique. On n'inspecte donc
        # ni l'indexation de ce `mixed`, ni sa transmission a une assertion
        # typee — uniquement dans tests/.
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: tests/
        -
            message: '#expects .+, mixed given\.$#'
            identifier: argument.type
            path: tests/
        -
            identifier: foreach.nonIterable
            path: tests/
