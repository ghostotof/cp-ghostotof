{#
   Layout de base de tous les e-mails HTML sortants (cf. tasks/plan.md, tâche 1.2).
   Contraintes clients mail : mise en page en <table>, styles 100 % inline, pas
   de CSS externe, fond clair + bandeau de marque au dégradé du site
   (#7c3aed → #4338ca, cf. frontend/src/style.css). `brand_name` est un global
   Twig (config/packages/twig.yaml). Les templates enfants remplissent {% block body %}.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{% block title %}{{ brand_name }}{% endblock %}</title>
</head>
<body style="margin:0; padding:0; width:100%; background-color:#f4f4f7; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#1f2430;">
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{% block preheader %}{% endblock %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f7;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:100%; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
                    <tr>
                        <td style="padding:24px 32px; background-color:#7c3aed; background-image:linear-gradient(135deg,#7c3aed,#4338ca);">
                            <span style="font-size:18px; font-weight:600; color:#ffffff; letter-spacing:0.02em;">
                                <span style="opacity:0.65; font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;">&lt;/&gt;</span>
                                {{ brand_name }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px; font-size:15px; line-height:1.6; color:#1f2430;">
                            {% block body %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px 32px; border-top:1px solid #e5e7eb; font-size:12px; line-height:1.6; color:#6b7280;">
                            {% block footer %}{{ brand_name }} — projet de démonstration personnel. Merci de ne pas répondre à cet e-mail.{% endblock %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
