{#
   E-mail d'invitation : un compte a été créé pour la personne depuis le
   backoffice, elle doit définir son mot de passe via `setupUrl`. Toutes les
   chaînes localisées arrivent dans `strings` (cf. SendAccountInvitationHandler) :
   ce template est une pure mise en page.
#}
{% extends 'emails/base.html.twig' %}

{% block title %}{{ strings.heading }}{% endblock %}

{% block preheader %}{{ strings.intro }}{% endblock %}

{% block body %}
    <h1 style="margin:0 0 16px; font-size:18px; font-weight:600; color:#1f2430;">{{ strings.heading }}</h1>

    <p style="margin:0 0 16px;">{{ strings.intro }}</p>

    <p style="margin:0 0 20px;">{{ strings.usernameLabel }} : <strong>{{ username }}</strong></p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;">
        <tr>
            <td style="border-radius:8px; background-color:#7c3aed; background-image:linear-gradient(135deg,#7c3aed,#4338ca);">
                <a href="{{ setupUrl }}" style="display:inline-block; padding:12px 24px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">{{ strings.cta }}</a>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 16px; color:#6b7280; font-size:13px;">{{ strings.expiryNote }}</p>

    <p style="margin:0 0 4px; color:#6b7280; font-size:13px;">{{ strings.fallbackNote }}</p>
    <p style="margin:0 0 16px; word-break:break-all;">
        <a href="{{ setupUrl }}" style="color:#7c3aed; font-size:13px;">{{ setupUrl }}</a>
    </p>

    <p style="margin:0; color:#6b7280; font-size:13px;">{{ strings.ignoreNote }}</p>
{% endblock %}
